# syntax=docker/dockerfile:1
FROM python:3.12-slim
WORKDIR /app
ARG APP_VERSION=v1
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 APP_VERSION=$APP_VERSION
COPY requirements.txt .
# IT 담당자에게 검증받은 루트 CA 번들(일반 공인 루트 + 학교 CA)을 빌드 시에만 제공합니다.
# 비밀 마운트는 이미지와 저장소에 저장하지 않으며 TLS 검증을 유지합니다.
RUN --mount=type=secret,id=ca_bundle,required=true pip install --no-cache-dir --cert /run/secrets/ca_bundle -r requirements.txt
COPY app.py .
EXPOSE 5000
CMD ["python", "app.py"]
